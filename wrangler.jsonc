{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "git-of-anton",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "web/out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Only these paths invoke the Worker; everything else is a free static-asset hit.
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    { "pattern": "gitofanton.com", "custom_domain": true }
  ],
  "observability": { "enabled": true },
  "d1_databases": [
    { "binding": "DB", "database_name": "git-of-anton", "database_id": "30e7cbc9-98e7-49e4-a699-d9c957593600", "migrations_dir": "migrations" }
  ],
  "kv_namespaces": [
    { "binding": "STATE", "id": "b35469b49bd34a39bd0503d95b7fe52c" }
  ]
  // M7 adds: send_email (CONTACT).
}
